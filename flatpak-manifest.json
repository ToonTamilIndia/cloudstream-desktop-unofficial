{
  "id": "com.github.toontamilindia.cloudstreamdesktop",
  "appstream-compose": false,
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "app/CloudStream-Desktop/bin/CloudStream-Desktop",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--device=all",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "cloudstream-desktop",
      "buildsystem": "simple",
      "build-commands": [],
      "sources": [
        {
          "type": "dir",
          "path": "flatpak/app/CloudStream-Desktop",
          "dest": "app/CloudStream-Desktop"
        }
      ]
    }
  ]
}
